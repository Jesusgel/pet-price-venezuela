# --- Database Configuration ---
# Example: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+asyncpg://petpriceuser:petpricepassword@localhost:5432/petpricedb

# --- Application Configuration ---
PROJECT_NAME="Pet-Price Venezuela MVP"
API_V1_STR=/api/v1
DEBUG=True
ENVIRONMENT=development  # development, staging, production
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# --- CORS Configuration ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Authentication & JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 días

# --- Rate Guard Settings ---
RATE_MIN=1.0
RATE_MAX=10000.0
RATE_DEVIATION_WARN_PCT=10.0

# --- Initial Admin Setup (Opcional, para creación desatendida) ---
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@elsaman.com
# ADMIN_PASSWORD=your_secure_password_here

# --- External APIs ---
DOLAR_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
